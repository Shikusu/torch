<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">

            <solid android:color="#0D0D0D" />

        </shape>
    </item>
    <item

        android:left="4dp"

        android:top="4dp">

        <shape android:shape="oval">

            <solid android:color="#00000000" />

            <stroke

                android:width="2dp"

                android:color="#33000000" />

        </shape>

    </item>


    <item

        android:bottom="4dp"

        android:right="4dp">

        <shape android:shape="oval">

            <solid android:color="#00000000" />

            <stroke

                android:width="1dp"

                android:color="#1AFFFFFF" />

        </shape>

    </item>


    <item>

        <shape android:shape="oval">

            <solid android:color="#00000000" />

            <stroke

                android:width="1dp"

                android:color="#1AFFFFFF" />

        </shape>

    </item>


</layer-list>