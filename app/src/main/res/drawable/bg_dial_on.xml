<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">

            <gradient

                android:angle="135"

                android:endColor="#0D0D0D"

                android:startColor="#1A1A1A"

                android:type="linear" />

        </shape>

    </item>


    <item

        android:bottom="2dp"

        android:left="2dp"

        android:right="2dp"

        android:top="2dp">

        <shape android:shape="oval">

            <solid android:color="#00000000" />

            <stroke

                android:width="2dp"

                android:color="#8000E5FF" />

        </shape>

    </item>


    <item>

        <shape android:shape="oval">

            <solid android:color="#00000000" />

            <stroke

                android:width="3dp"

                android:color="#3300E5FF" />
        </shape>

    </item>


</layer-list>